    <exercises>
        <title>5.5: Radiation Safety</title>

        <exercisegroup>
            <exercise>
                <statement>
                    <p>
                        A worker must briefly handle a gamma-emitting source.
                        Name two exposure-control strategies that could reduce
                        dose.
                    </p>
                </statement>

                <answer>
                    <p>
                        Any two of: reduce time, increase distance, use
                        appropriate shielding, or minimize the amount/activity
                        handled.
                    </p>
                </answer>
            </exercise>

