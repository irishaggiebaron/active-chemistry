    <exercises>
        <title>5.6: Half-life of Radioisotopes</title>

        <exercisegroup>
            <exercise>
                <statement>
                    <p>
                        A sample begins with 80.0 mg of a radioisotope.
                        How much remains after 3 half-lives?
                    </p>
                </statement>

                <answer>
                    <p>
                        10.0 mg.
                    </p>
                </answer>
            </exercise>

