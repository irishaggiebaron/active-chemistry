    <exercises>
        <title>5.2: Balancing Decay Reactions</title>

        <exercisegroup>
            <exercise>
                <statement>
                    <p>
                        Write the nuclear equation for alpha decay of
                        uranium-238.
                    </p>
                </statement>

                <answer>
                    <p>
                        <m>{}^{238}_{92}\mathrm{U}\rightarrow{}^{4}_{2}\mathrm{He}+{}^{234}_{90}\mathrm{Th}</m>
                    </p>
                </answer>
            </exercise>

            <exercise>
                <statement>
                    <p>
                        Answer the following and briefly justify your reasoning:
                        Write the nuclear equation for alpha decay of
