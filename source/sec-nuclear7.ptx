<!-- Generated by Pandoc using pretext.lua -->
<section xml:id="sec-nuclear7" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Additional exercises for Chapter 5</title>

    <p>
        <em>These questions were generated by ChatGPT using prompts from Dr. Vranish.  The questions have been edited and the answers to the questions have been confirmed by Dr. Vranish</em>
    </p>

    <exercises>
        <title>5.1: Types of Radioactivity</title>

        <exercise xml:id="new-36-01">
            <title>Particle notation</title>

            <statement>
                <p>
                    Give the nuclear symbol, mass number, and charge of an alpha
                    particle.
                </p>
            </statement>

            <answer>
                <p>
                    <m>^{4}_{2}\mathrm{He}</m>; mass number 4, charge <m>2+</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-02">
            <title>Beta identity</title>

            <statement>
                <p>
                    What particle is emitted in beta decay?
                </p>
            </statement>

            <answer>
                <p>
                    An electron, conventionally written
                    <m>^{0}_{-1}\mathrm{e}</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-03">
            <title>Gamma properties</title>

            <statement>
                <p>
                    Does a gamma photon carry electric charge or mass?
                </p>
            </statement>

            <answer>
                <p>
                    Neither; its charge and mass number are zero.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-04">
            <title>Positron</title>

            <statement>
                <p>
                    How does a positron differ from an electron in charge and
                    mass?
                </p>
            </statement>

            <answer>
                <p>
                    It has the same mass but opposite (positive) charge.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-05">
            <title>Charge ranking</title>

            <statement>
                <p>
                    Order beta, gamma, and alpha radiation by electric
                    charge.
                </p>
            </statement>

            <answer>
                <p>
                    Beta: <m>1-</m>; gamma: 0; alpha: <m>2+</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-06">
            <title>Mass comparison</title>

            <statement>
                <p>
                    Which has greater particle mass, an alpha particle or a beta
                    particle?
                </p>
            </statement>

            <answer>
                <p>
                    The alpha particle.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-07">
            <title>Lacks a charge</title>

            <statement>
                <p>
                    Which of alpha, beta, positrons, protons, neutrons and gamma radiation lacks an electrical charge?
                </p>
            </statement>

            <answer>
                <p>
                    Gamma radiation, and neutrons
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-08">
            <title>Atomic effect</title>

            <statement>
                <p>
                    Which listed emission leaves both atomic number and mass
                    number unchanged?
                </p>
            </statement>

            <answer>
                <p>
                    Gamma emission.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-09">
            <title>Misconception</title>

            <statement>
                <p>
                    Does beta emission mean an orbital electron simply
                    escaped from an otherwise unchanged nucleus?
                </p>
            </statement>

            <answer>
                <p>
                    No.
                    A nuclear neutron converts to a proton, with an electron being emitted.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-36-10">
            <title>Identification</title>

            <statement>
                <p>
                    A nuclear emission has mass number of 1 and charge
                    <m>1+</m>.
                    Identify it.
                </p>
            </statement>

            <answer>
                <p>
                    A proton
                </p>
            </answer>
        </exercise>
    </exercises>

    <exercises>
        <title>5.2: Balancing Decay Reactions</title>

        <exercise xml:id="new-37-01">
            <title>Alpha equation</title>

            <statement>
                <p>
                    Complete
                    <m>^{238}_{92}\mathrm{U}\rightarrow\,\underline{\hspace{1cm}}+{}^{4}_{2}\mathrm{He}</m>.
                </p>
            </statement>

            <answer>
                <p>
                    <m>^{234}_{90}\mathrm{Th}</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-02">
            <title>Beta daughter reasoning</title>

            <statement>
                <p>
                    Phosphorus-32 emits a beta particle.
                    Predict the resulting isotope and explain why the atomic number rises
                    although the mass number stays fixed.
                </p>
            </statement>

            <answer>
                <p>
                    The daughter is <m>^{32}_{16}\mathrm{S}</m>.
                    A neutron converts to a proton which affects the atomic number.  The mass of a proton an neutron are essentially the same, so the mass number doesn't change.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-03">
            <title>Positron verification</title>

            <statement>
                <p>
                    A proposed positron decay is
                    <m>^{18}_{9}\mathrm{F}\rightarrow{}^{18}_{10}\mathrm{Ne}+{}^{0}_{1}\mathrm{e}</m>.
                    Correct it.
                </p>
            </statement>

            <answer>
                <p>
                    The resulting isotope must be <m>^{18}_{8}\mathrm{O}</m> because
                    <m>9=8+1</m>; mass number remains 18.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-04">
            <title>Gamma equation</title>

            <statement>
                <p>
                    Write the gamma emission of excited technetium-99, denoted
                    <m>^{99m}_{43}\mathrm{Tc}</m>.
                </p>
            </statement>

            <answer>
                <p>
                    <m>^{99m}_{43}\mathrm{Tc}\rightarrow{}^{99}_{43}\mathrm{Tc}+\gamma</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-05">
            <title>Missing emission</title>

            <statement>
                <p>
                    Identify the emission in
                    <m>^{210}_{84}\mathrm{Po}\rightarrow{}^{206}_{82}\mathrm{Pb}+\underline{\hspace{1cm}}</m>.
                </p>
            </statement>

            <answer>
                <p>
                    An alpha particle, <m>^{4}_{2}\mathrm{He}</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-06">
            <title>Conservation check</title>

            <statement>
                <p>
                    Why is
                    <m>^{14}_{6}\mathrm{C}\rightarrow{}^{14}_{6}\mathrm{C}+{}^{0}_{-1}\mathrm{e}</m>
                    not a balanced beta-decay equation?
                </p>
            </statement>

            <answer>
                <p>
                    Atomic-number sums differ; the product isotope should have atomic
                    number 7.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-07">
            <title>Sequential decay</title>

            <statement>
                <p>
                    A nucleus undergoes alpha decay then beta decay.
                    What are the net changes in mass and atomic number?
                </p>
            </statement>

            <answer>
                <p>
                    Mass number decreases by 4; atomic number decreases by 1.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-08">
            <title>Electron capture</title>

            <statement>
                <p>
                    Electron capture is a process that can occur in the nucleus of certain atoms.  It follows the same rules as radioactive decay, but in the opposite direction.  Complete
                    <m>^{7}_{4}\mathrm{Be}+{}^{0}_{-1}\mathrm{e}\rightarrow\underline{\hspace{1cm}}</m>
                    in simplified notation.
                </p>
            </statement>

            <answer>
                <p>
                    <m>^{7}_{3}\mathrm{Li}</m>
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-09">
            <title>Reverse inference</title>

            <statement>
                <p>
                    <m>^{222}_{86}\mathrm{Rn}</m> is produced from an alpha decay reaction.
                    Find the parent isotope.
                </p>
            </statement>

            <answer>
                <p>
                    <m>^{226}_{88}\mathrm{Ra}</m>.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-37-10">
            <title>Element change</title>

            <statement>
                <p>
                    Why does gamma emission not turn one element into another?
                </p>
            </statement>

            <answer>
                <p>
                    It changes nuclear energy, not proton count.
                </p>
            </answer>
        </exercise>
    </exercises>

    <exercises>
        <title>5.3: Uses of Radioactive Materials</title>

        <exercise xml:id="new-38-01">
            <title>Chain reaction</title>

            <statement>
                <p>
                    Explain how neutrons sustain a fission chain reaction.
                </p>
            </statement>

            <answer>
                <p>
                    Neutrons released by one fission event can trigger fission
                    in additional nuclei.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-02">
            <title>Control rods</title>

            <statement>
                <p>
                    What role do neutron-absorbing control rods play in a
                    reactor?
                </p>
            </statement>

            <answer>
                <p>
                    They reduce available neutrons and control the chain
                    reaction rate.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-03">
            <title>Tracer</title>

            <statement>
                <p>
                    Why can a small radioactive tracer help locate a substance
                    within a body?
                </p>
            </statement>

            <answer>
                <p>
                    Its emitted radiation can be detected outside the body to
                    reveal its distribution.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-04">
            <title>PET signal</title>

            <statement>
                <p>
                    What produces the photons detected in positron emission
                    tomography?
                </p>
            </statement>

            <answer>
                <p>
                    A positron annihilates with an electron, typically producing
                    two gamma photons.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-05">
            <title>Targeting</title>

            <statement>
                <p>
                    Why might a glucose-like tracer accumulate more strongly in
                    some tumors?
                </p>
            </statement>

            <answer>
                <p>
                    Some tumors have elevated glucose uptake
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-06">
            <title>Therapy versus imaging</title>

            <statement>
                <p>
                    How does using radiation to destroy tumor cells differ from
                    using a tracer to image them?
                </p>
            </statement>

            <answer>
                <p>
                    Therapy aims to deliver damaging energy; imaging aims to
                    detect distribution but with less damaging quantities of radiation
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-07">
            <title>Isotope choice</title>

            <statement>
                <p>
                    Why is a very long-lived tracer often undesirable for short
                    diagnostic imaging?
                </p>
            </statement>

            <answer>
                <p>
                    It can continue irradiating the person after useful imaging
                    has ended.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-08">
            <title>Energy pathway</title>

            <statement>
                <p>
                    Trace the main energy conversions from fission to
                    electricity in a typical power plant.
                </p>
            </statement>

            <answer>
                <p>
                    Nuclear energy becomes heat, then turbine mechanical energy,
                    then electrical energy.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-38-10">
            <title>Sterilization</title>

            <statement>
                <p>
                    How can radiation sterilize equipment without heating it to
                    a high temperature?
                </p>
            </statement>

            <answer>
                <p>
                    Ionizing radiation damages microorganisms and their
                    molecular machinery.
                </p>
            </answer>
        </exercise>
    </exercises>

    <exercises>
        <title>5.4: Measuring radioactivity</title>

        <exercise xml:id="new-39-01">
            <title>Activity conversion</title>

            <statement>
                <p>
                    Convert 2.00 Ci to Bq using
                    <m>1\,\mathrm{Ci}=3.70\times10^{10}</m> Bq.
                </p>
            </statement>

            <answer>
                <p>
                    <m>7.40\times10^{10}</m> Bq.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-02">
            <title>Reverse conversion</title>

            <statement>
                <p>
                    Convert <m>7.40\times10^7</m> Bq to mCi.
                </p>
            </statement>

            <answer>
                <p>
                    2.00 mCi.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-03">
            <title>Disintegration count</title>

            <statement>
                <p>
                    A source has constant activity 500.
                    Bq over 10.0 s.
                    How many decays are expected?
                </p>
            </statement>

            <answer>
                <p>
                    <m>5.00\times10^3</m> decays.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-04">
            <title>Activity meaning</title>

            <statement>
                <p>
                    What is the definition of one Bq?
                </p>
            </statement>

            <answer>
                <p>
                    One nuclear decay per second.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-05">
            <title>Absorbed dose</title>

            <statement>
                <p>
                    Convert 250. rad to Gy using 100 rad = 1 Gy.
                </p>
            </statement>

            <answer>
                <p>
                    2.50 Gy
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-06">
            <title>Equivalent dose</title>

            <statement>
                <p>
                    Convert 75.0 mrem to mSv using 100 rem = 1 Sv.
                </p>
            </statement>

            <answer>
                <p>
                    0.750 mSv.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-07">
            <title>Quantity distinction</title>

            <statement>
                <p>
                    Explain the difference between activity and absorbed dose.
                </p>
            </statement>

            <answer>
                <p>
                    Activity measures decay rate; absorbed dose measures energy
                    deposited per mass.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-08">
            <title>Biological weighting</title>

            <statement>
                <p>
                    Why might equal absorbed doses of different radiation types
                    have different biological effects?
                </p>
            </statement>

            <answer>
                <p>
                    Radiation types have different biological effectiveness,
                    represented by weighting factors.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-09">
            <title>Energy per mass</title>

            <statement>
                <p>
                    A person absorbs 15 rad of alpha particles.  What is that equivalent to in Sv?  Also, is the person likely fine, soon to be sick, or soon to be dead?
                </p>
            </statement>

            <answer>
                <p>
                    3Sv, they likely experience a fatal dose (a dose of 3-4 Sv is lethal to half of the people exposed to that amount).
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-39-10">
            <title>Comparison</title>

            <statement>
                <p>
                    Which source has greater activity: 1.00 microcurie or
                    <m>5.00\times10^4</m> Bq?
                </p>
            </statement>

            <answer>
                <p>
                    The latter; 1.00 microcurie is <m>3.70\times10^4</m> Bq.
                </p>
            </answer>
        </exercise>
    </exercises>

    <exercises>
        <title>5.5: Radiation Safety</title>

        <exercise xml:id="new-40-01">
            <title>Time</title>

            <statement>
                <p>
                    For a fixed dose rate, what happens to exposure when time is
                    halved?
                </p>
            </statement>

            <answer>
                <p>
                    The dose is halved.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-02">
            <title>Distance</title>

            <statement>
                <p>
                    For an unshielded point source, what happens to intensity
                    when distance doubles?
                </p>
            </statement>

            <answer>
                <p>
                    It falls to one quarter by the inverse-square relationship.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-03">
            <title>Shielding</title>

            <statement>
                <p>
                    Which is more easily stopped by paper, alpha or gamma
                    radiation?
                </p>
            </statement>

            <answer>
                <p>
                    Alpha radiation.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-04">
            <title>Internal contamination</title>

            <statement>
                <p>
                    Why is preventing inhalation of radioactive dust important?
                </p>
            </statement>

            <answer>
                <p>
                    It prevents radioactive material from becoming an internal
                    source of exposure.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-05">
            <title>Practical control</title>

            <statement>
                <p>
                    How can remote handling tools reduce exposure?
                </p>
            </statement>

            <answer>
                <p>
                    They increase distance from the source and may allow the presence of shielding between the operator and the material.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-06">
            <title>Inverse distance</title>

            <statement>
                <p>
                    A point-source dose rate is 8.0 mrad/h at 1.0 m.
                    What is it at 4.0 m under the same assumptions?
                </p>
            </statement>

            <answer>
                <p>
                    0.50 mrad/h.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-07">
            <title>Dose calculation</title>

            <statement>
                <p>
                    At a hypothetical constant dose rate of 0.20 mSv/h, what
                    dose accumulates in 15 min?
                </p>
            </statement>

            <answer>
                <p>
                    0.050 mSv.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-08">
            <title>Combined controls</title>

            <statement>
                <p>
                    Time is halved and distance from an unshielded point source
                    is doubled.
                    What fraction of the original dose remains?
                </p>
            </statement>

            <answer>
                <p>
                    One eighth.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-40-09">
            <title>Protective clothing</title>

            <statement>
                <p>
                    Does wearing rubber gloves provide substantial shielding from
                    penetrating gamma radiation?
                </p>
            </statement>

            <answer>
                <p>
                    No.
                    Gloves mainly help prevent contamination; penetrating
                    radiation requires appropriate shielding.
                </p>
            </answer>
        </exercise>

  
    <exercises>
        <title>5.6: Half-life of Radioisotopes</title>

        <exercise xml:id="new-41-01">
            <title>Whole half-lives</title>

            <statement>
                <p>
                    An 80.0 mg sample undergoes three half-lives of decay.
                    Find the amount remaining.
                </p>
            </statement>

            <answer>
                <p>
                    10.0 mg.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-02">
            <title>Elapsed time</title>

            <statement>
                <p>
                    A nuclide has half-life 6.00 h.
                    How long is required for activity to fall to one quarter?
                </p>
            </statement>

            <answer>
                <p>
                    12.0 h.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-03">
            <title>Half-life inference</title>

            <statement>
                <p>
                    Activity drops from 160 Bq to 20 Bq in 9.0 days.
                    Find the half-life.
                </p>
            </statement>

            <answer>
                <p>
                    3.0 days.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-04">
            <title>Fractional time</title>

            <statement>
                <p>
                    Find the fraction remaining after half a half-life.
                </p>
            </statement>

            <answer>
                <p>
                    <m>2^{-1/2}\approx0.707</m>, or 70.7 percent.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-05">
            <title>Reverse amount</title>

            <statement>
                <p>
                    A sample contains 5.00 mg after two half-lives.
                    What was its starting amount?
                </p>
            </statement>

            <answer>
                <p>
                    20.0 mg.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-06">
            <title>Decayed fraction</title>

            <statement>
                <p>
                    What percentage of a radioactive sample remains after four half-lives?
                </p>
            </statement>

            <answer>
                <p>
                    93.75 percent.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-07">
            <title>Different nuclides</title>

            <statement>
                <p>
                    Two equally active sources have half-lives of 1 h and 10 h.
                    Which has higher activity after 5 h?
                </p>
            </statement>

            <answer>
                <p>
                    The 10 h source.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-08">
            <title>Activity model</title>

            <statement>
                <p>
                    A source starts at 25000 Bq with half-life 2.00 days.
                    Find activity after 7.00 days.
                </p>
            </statement>

            <answer>
                <p>
                    2200 Bq.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-09">
            <title>Misconception</title>

            <statement>
                <p>
                    Does every remaining nucleus necessarily decay during the
                    next half-life?
                </p>
            </statement>

            <answer>
                <p>
                    No.
                    Decay is probabilistic; half the population is expected to
                    remain.
                </p>
            </answer>
        </exercise>

        <exercise xml:id="new-41-10">
            <title>Threshold</title>

            <statement>
                <p>
                    How many whole half-lives are needed for less than 1 percent
                    to remain?
                </p>
            </statement>

            <answer>
                <p>
                    Seven, leaving about 0.781 percent.
                </p>
            </answer>
        </exercise>
    </exercises>
</section>