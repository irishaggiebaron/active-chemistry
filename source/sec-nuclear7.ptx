    <exercises>
        <title>5.1: Types of Radioactivity</title>

        <exercisegroup>
            <exercise>
                <statement>
                    <p>
                        Compare alpha and beta particles in terms of charge and
                        approximate mass.
                    </p>
                </statement>

                <answer>
                    <p>
                        Alpha: +2 charge and about 4 amu.
                        Beta minus: -1 charge and negligible mass on the amu
                        scale.
                    </p>
                </answer>
            </exercise>

            <exercise>
                <statement>
                    <p>
                        Answer the following and briefly justify your reasoning:
                        Compare alpha and beta particles in terms of charge and
                        approximate mass.
                    </p>
                </statement>

                <answer>
                    <p>
                        Alpha: +2 charge and about 4 amu.
                        Beta minus: -1 charge and negligible mass on the amu
                        scale.
                        A correct justification should connect the answer to the
                        relevant definition, relationship, or calculation from
                        this section.
                    </p>
                </answer>
            </exercise>

