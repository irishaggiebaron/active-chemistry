            <exercise>
                <statement>
                    <p>
                        Which contributes more to an atom’s mass: 20 electrons
                        or one proton?
                    </p>
                </statement>

                <answer>
                    <p>
                        One proton.
                        An electron has far less mass than a proton.
                    </p>
                </answer>
            </exercise>

