					<p>
						Ammonia and hydroiodic acid
					</p>
				</statement>
			</exercise>

			<exercise>
				<statement>
					<p>
						Potassium hydroxide and potassium hydrogen carbonate
					</p>
				</statement>
			</exercise>

			<exercise>
