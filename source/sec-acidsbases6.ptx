		<title>Exercise 1</title>

		<exercisegroup>
			<introduction>
				<p>
					Write an ionic equation, net ionic equation, and chemical equation for the
					following reactions:
				</p>
			</introduction>

			<exercise>
				<statement>
					<p>
						Potassium hydroxide and hydrobromic acid
					</p>
				</statement>
			</exercise>

			<exercise>
				<statement>
					<p>
						Nitric acid and sodium hydroxide
					</p>
				</statement>
			</exercise>

			<exercise>
